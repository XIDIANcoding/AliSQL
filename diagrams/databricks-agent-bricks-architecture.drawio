<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="databricks-arch" name="Databricks Mosaic AI Agent Bricks Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User App Layer -->
        <mxCell id="app_box" value="应用与接入端 (Chatbot / 业务系统 / IDE / MCP 客户端)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="1040" height="38" as="geometry" />
        </mxCell>

        <!-- Multi-Agent Supervisor -->
        <mxCell id="mas_box" value="1. Mosaic AI Agent Framework (Agent Bricks &amp; Multi-Agent Supervisor)  【落点：新增外部服务 / Model Serving 容器化部署】" style="swimlane;startSize=28;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="80" width="1040" height="155" as="geometry" />
        </mxCell>
        <mxCell id="mas_sup" value="Multi-Agent Supervisor&#xa;【新增外部编排微服务】&#xa;意图分类 / 任务拆解 / 路由编排" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=10.5;fontStyle=1;" vertex="1" parent="mas_box">
          <mxGeometry x="25" y="45" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mas_genie" value="Genie Space (SQL Agent)&#xa;【新增外部 AI 服务】&#xa;针对 Gold 业务表自动生成 SQL&#xa;高精度指标与聚合分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=10.5;" vertex="1" parent="mas_box">
          <mxGeometry x="280" y="45" width="225" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mas_ka" value="Knowledge Assistant&#xa;【新增外部 RAG 服务】&#xa;基于 AI Search 混合检索&#xa;非结构化财报/专利/文档 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=10.5;" vertex="1" parent="mas_box">
          <mxGeometry x="525" y="45" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mas_tools" value="UC Functions (确定性工具)&#xa;【管控面函数注册 + 容器执行】&#xa;风控计算 / 审批逻辑 / 定价算法&#xa;可审计的 Python / SQL 工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=10.5;" vertex="1" parent="mas_box">
          <mxGeometry x="780" y="45" width="235" height="85" as="geometry" />
        </mxCell>

        <!-- Connector Banner 1 -> 2 -->
        <mxCell id="banner_db_12" value="层间配合：Agent 严格继承用户身份 Token ── 统一进行权限评估、动态列脱敏、行级过滤 (RLS) 与 MLflow 审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=11;fontColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="100" y="250" width="940" height="34" as="geometry" />
        </mxCell>

        <!-- Unity Catalog Governance -->
        <mxCell id="uc_box" value="2. 统一治理控制面 (Unity Catalog)  【落点：管控面独立服务集群 + 元数据库】" style="swimlane;startSize=28;fillColor=#e8eaf6;strokeColor=#283593;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="1040" height="115" as="geometry" />
        </mxCell>
        <mxCell id="uc_item1" value="统一身份继承&#xa;【管控面鉴权模块】&#xa;(Agent 遵循发起人 RBAC 权限)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=10.5;" vertex="1" parent="uc_box">
          <mxGeometry x="25" y="42" width="225" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_item2" value="行级安全 (RLS) &amp; 列脱敏&#xa;【管控面安全策略引擎】&#xa;(向量索引与源表一致脱敏)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=10.5;" vertex="1" parent="uc_box">
          <mxGeometry x="270" y="42" width="235" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_item3" value="MLflow 自动评估与追踪&#xa;【管控面 MLOps 审计服务】&#xa;(Tracing / 延迟 / 成本 / 幻觉评测)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=10.5;" vertex="1" parent="uc_box">
          <mxGeometry x="525" y="42" width="235" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_item4" value="端到端血缘 (Lineage)&#xa;【管控面元数据图谱】&#xa;(源表 -&gt; 向量索引 -&gt; Agent 回复)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=10.5;" vertex="1" parent="uc_box">
          <mxGeometry x="780" y="42" width="235" height="55" as="geometry" />
        </mxCell>

        <!-- Connector Banner 2 -> 3 -->
        <mxCell id="banner_db_23" value="层间配合：Change Data Feed (CDF) 自动捕获表变更 ── 复制管道 / Serverless 异步实时增量向量化 (免建任何 ETL 管道)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaf6;strokeColor=#283593;fontStyle=1;fontSize=11;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="940" height="34" as="geometry" />
        </mxCell>

        <!-- Storage & Sync Layer -->
        <mxCell id="lake_box" value="3. 湖仓存储与自动同步索引层 (Delta Lake &amp; Databricks AI Search)  【落点：内核引擎 + 复制管道 + 向量检索引擎】" style="swimlane;startSize=28;fillColor=#e0f2f1;strokeColor=#00695c;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="480" width="1040" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lake_delta" value="既有 Delta Table (结构化/文本)&#xa;【计算/存储引擎层 - 对象存储】&#xa;Bronze / Silver / Gold 分层架构&#xa;(企业最核心事实资产与业务数据)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;fontSize=10.5;fontStyle=1;" vertex="1" parent="lake_box">
          <mxGeometry x="25" y="45" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="lake_cdf" value="Change Data Feed (CDF)&#xa;【复制与变更日志管道】&#xa;行级增删改事件实时流式广播&#xa;(驱动向量索引零延迟更新)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=10.5;fontStyle=1;" vertex="1" parent="lake_box">
          <mxGeometry x="340" y="45" width="280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="lake_aisearch" value="Databricks AI Search 托管索引&#xa;【独立向量搜索服务 / Serverless】&#xa;Serverless 自动调用模型计算 Embedding&#xa;HNSW 向量 + BM25 关键词混合检索引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;fontSize=10.5;fontStyle=1;" vertex="1" parent="lake_box">
          <mxGeometry x="645" y="45" width="370" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
