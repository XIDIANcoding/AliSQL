<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="databricks-arch" name="Databricks Mosaic AI Agent Bricks Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User App Layer -->
        <mxCell id="app_box" value="应用与接入端 (Chatbot / 业务系统 / IDE / MCP 客户端)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1020" height="40" as="geometry" />
        </mxCell>

        <!-- Multi-Agent Supervisor -->
        <mxCell id="mas_box" value="1. Mosaic AI Agent Framework (Agent Bricks &amp; Multi-Agent Supervisor)" style="swimlane;startSize=28;fillColor=#fff3e0;strokeColor=#e65100;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="1020" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mas_sup" value="Multi-Agent Supervisor&#xa;意图分类 / 任务拆解 / 路由编排" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="mas_box">
          <mxGeometry x="30" y="45" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mas_genie" value="Genie Space (SQL Agent)&#xa;针对 Gold 业务表自动生成 SQL&#xa;高精度指标与聚合分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;" vertex="1" parent="mas_box">
          <mxGeometry x="290" y="45" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mas_ka" value="Knowledge Assistant&#xa;基于 AI Search 混合检索&#xa;非结构化财报/专利/文档 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;" vertex="1" parent="mas_box">
          <mxGeometry x="540" y="45" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="mas_tools" value="UC Functions (确定性工具)&#xa;风控计算 / 审批逻辑 / 定价算法&#xa;可审计的 Python / SQL 函数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e65100;fontSize=11;" vertex="1" parent="mas_box">
          <mxGeometry x="785" y="45" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- Unity Catalog Governance -->
        <mxCell id="uc_box" value="2. 统一治理控制面 (Unity Catalog - 贯穿数据、模型与 Agent 工具)" style="swimlane;startSize=28;fillColor=#e8eaf6;strokeColor=#283593;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="1020" height="100" as="geometry" />
        </mxCell>
        <mxCell id="uc_item1" value="统一身份继承&#xa;(Agent 遵循发起人权限)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=11;" vertex="1" parent="uc_box">
          <mxGeometry x="30" y="40" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc_item2" value="行级安全 (RLS) &amp; 列脱敏&#xa;(向量索引与源表一致脱敏)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=11;" vertex="1" parent="uc_box">
          <mxGeometry x="280" y="40" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc_item3" value="MLflow 自动评估与追踪&#xa;(Tracing / 延迟 / 成本 / 幻觉评测)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=11;" vertex="1" parent="uc_box">
          <mxGeometry x="530" y="40" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="uc_item4" value="端到端血缘 (Lineage)&#xa;(源表 -&gt; 向量索引 -&gt; Agent 回复)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#283593;fontSize=11;" vertex="1" parent="uc_box">
          <mxGeometry x="780" y="40" width="215" height="45" as="geometry" />
        </mxCell>

        <!-- Storage & Sync Layer -->
        <mxCell id="lake_box" value="3. 湖仓存储与自动同步索引层 (Delta Lake &amp; Databricks AI Search)" style="swimlane;startSize=28;fillColor=#e0f2f1;strokeColor=#00695c;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="1020" height="140" as="geometry" />
        </mxCell>
        <mxCell id="lake_delta" value="既有 Delta Table (结构化/文本)&#xa;Bronze / Silver / Gold 分层架构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;fontSize=11;fontStyle=1;" vertex="1" parent="lake_box">
          <mxGeometry x="40" y="45" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lake_cdf" value="Change Data Feed (CDF)&#xa;变更数据捕获 (免手动 ETL 管道)" style="shape=flexArrow;endArrow=classic;html=1;fillColor=#b2dfdb;strokeColor=#00695c;fontSize=11;" vertex="1" parent="lake_box">
          <mxGeometry x="360" y="55" width="250" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lake_aisearch" value="Databricks AI Search 索引&#xa;Serverless 自动计算 Embedding&#xa;HNSW 向量 + BM25 全文混合索引" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#00695c;fontSize=11;fontStyle=1;" vertex="1" parent="lake_box">
          <mxGeometry x="650" y="45" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- Connectors -->
        <mxCell id="ec1" value="REST / Agent 调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#e65100;" edge="1" parent="1" source="app_box" target="mas_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec2" value="受控访问与鉴权审计" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#283593;" edge="1" parent="1" source="mas_box" target="uc_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ec3" value="下发 SQL 查询与向量检索引擎" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#00695c;" edge="1" parent="1" source="uc_box" target="lake_box">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
