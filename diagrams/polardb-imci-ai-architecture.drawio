<mxfile host="drawio" version="26.0.0"><diagram id="polardb-imci-ai-architecture" name="PolarDB：InnoDB IMCI + AI 节点的库仓一体与 Data+AI"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1200" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="RW 主节点 / InnoDB 行存&amp;#xa;OLTP 写入、事务与 Redo&amp;#xa;列存索引以 InnoDB Secondary Index 实现&amp;#xa;[P1][P2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="45" width="275" height="95" as="geometry" /></mxCell><mxCell id="3" value="PolarDB 物理复制 / Redo 回放&amp;#xa;RO/Standby 节点从 Redo 重建与维护 IMCI&amp;#xa;不是 Kafka/Flink 外部 ETL&amp;#xa;[P1][P2][P3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cffafe;strokeColor=#0891b2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="45" width="270" height="95" as="geometry" /></mxCell><mxCell id="4" value="RO AP 节点 / IMCI&amp;#xa;压缩列存：默认内存，不足时落共享存储&amp;#xa;行存串行/并行/IMCI 三路径成本选择&amp;#xa;[P1][P2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="755" y="45" width="305" height="95" as="geometry" /></mxCell><mxCell id="5" value="PolarDB 共享存储&amp;#xa;一写多读；IMCI 可部署 RW、专用 AP RO&amp;#xa;或独立 Standby，隔离级别不同&amp;#xa;[P1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="235" width="300" height="90" as="geometry" /></mxCell><mxCell id="6" value="PolarDB for AI 节点&amp;#xa;独立计费计算节点；可含 GPU&amp;#xa;隔离 AI/ML 训练与推理负载&amp;#xa;[P4][P5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="235" width="300" height="90" as="geometry" /></mxCell><mxCell id="7" value="PolarDB for AI Serverless / VNode&amp;#xa;Data-Agent 可选 Serverless 调用计费&amp;#xa;GPU VNode 以 Pod 调度到托管资源池&amp;#xa;[P5][P6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="235" width="300" height="90" as="geometry" /></mxCell><mxCell id="8" value="SQL / Data-Agent 接口&amp;#xa;PolarDB for AI 通过 SQL 提供 MLOps、&amp;#xa;NL2SQL、NL2Chart、Summary&amp;#xa;[P4][P6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="300" height="95" as="geometry" /></mxCell><mxCell id="9" value="IMCI 向量/RAG 数据路径&amp;#xa;列存节点构建向量索引并检索&amp;#xa;AI 节点提供向量化与 LLM 能力&amp;#xa;[P7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="300" height="95" as="geometry" /></mxCell><mxCell id="10" value="DMS + PolarDB for AI&amp;#xa;面向业务用户的自然语言分析入口&amp;#xa;雅迪 10万+ 销售、准确率超90%&amp;#xa;[P8]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="280" height="95" as="geometry" /></mxCell><mxCell id="100" value="提交后复制 Redo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="101" value="后台构建/增量维护列存索引" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="102" value="共享数据文件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="5" target="2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="103" value="列存溢写/共享 I/O" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="5" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="104" value="SQL 路由模型训练/推理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="8" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="105" value="按模式选择专属或 Serverless" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="8" target="7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="106" value="Embedding / LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="107" value="向量索引与检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="108" value="自然语言请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="10" target="8"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>