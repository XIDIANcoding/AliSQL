        <mxCell id="layer1" value="1. 智能交互与 Agent 编排层 (Select AI &amp; Select AI Agent Framework)" style="swimlane;startSize=28;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
