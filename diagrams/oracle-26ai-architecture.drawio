<mxfile host="drawio" version="26.0.0"><diagram id="oracle-26ai-architecture" name="Oracle 26ai：从数据库内核扩展 AI 与湖仓"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1200" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="Select AI Agent&amp;#xa;数据库内框架（DBMS_CLOUD_AI_AGENT）&amp;#xa;Planning / Tool / Reflection / Memory&amp;#xa;[O4]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="45" width="290" height="90" as="geometry" /></mxCell><mxCell id="3" value="Autonomous AI Database MCP Server&amp;#xa;每数据库托管、多租户 MCP 服务&amp;#xa;无需客户另建 MCP 基础设施&amp;#xa;[O5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="45" width="290" height="90" as="geometry" /></mxCell><mxCell id="4" value="模型来源&amp;#xa;外部 LLM Provider（可选）&amp;#xa;或数据库内加载 ONNX Embedding&amp;#xa;[O4][O6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="45" width="300" height="90" as="geometry" /></mxCell><mxCell id="5" value="OLTP 行格式&amp;#xa;Buffer Cache / ACID / SQL&amp;#xa;适合点查与更新&amp;#xa;[O1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="235" height="105" as="geometry" /></mxCell><mxCell id="6" value="Database In-Memory&amp;#xa;SGA 内 IM Column Store&amp;#xa;后台 IMCO/SMCO/Wnnn 填充与重填&amp;#xa;不是外部 CDC&amp;#xa;[O1][O2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="210" width="235" height="105" as="geometry" /></mxCell><mxCell id="7" value="AI Vector Search&amp;#xa;VECTOR 类型 / 向量池 / 索引&amp;#xa;关系条件与向量检索同 SQL&amp;#xa;[O1][O3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="210" width="235" height="105" as="geometry" /></mxCell><mxCell id="8" value="Converged Engine&amp;#xa;JSON / Graph / Spatial / Relational&amp;#xa;统一安全与事务&amp;#xa;[O1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="855" y="210" width="205" height="105" as="geometry" /></mxCell><mxCell id="9" value="Exadata AI Smart Scan&amp;#xa;存储服务器执行距离计算与 Top-K&amp;#xa;减少网络与 DB Server 处理&amp;#xa;[O3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="300" height="95" as="geometry" /></mxCell><mxCell id="10" value="Autonomous AI Lakehouse&amp;#xa;外部 Apache Iceberg 表原位查询&amp;#xa;统一 Catalog / Data Lake Accelerator&amp;#xa;[O7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="420" width="300" height="95" as="geometry" /></mxCell><mxCell id="11" value="对象存储 / Iceberg 数据&amp;#xa;OCI / AWS / Azure / GCP&amp;#xa;开放数据保留在原位置&amp;#xa;[O7]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="420" width="280" height="95" as="geometry" /></mxCell><mxCell id="100" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2" target="5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="101" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3" target="2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="102" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;