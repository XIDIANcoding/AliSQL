. 距离计算与 Top-K 下推" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="678" width="490" height="28" as="geometry" /></mxCell><mxCell id="118" value="9. Iceberg/Catalog 解析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="712" width="490" height="28" as="geometry" /></mxCell><mxCell id="119" value="10. SQL 原位关联查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="746" width="490" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>