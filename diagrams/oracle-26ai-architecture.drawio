<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="oracle-arch" name="Oracle 26ai Autonomous AI Lakehouse">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Top Layer: Select AI Agent -->
        <mxCell id="layer1" value="1. 智能交互与 Agent 编排层 (Select AI Agent Framework)  【落点：管控面微服务 + 库内 PL/SQL 运行时】" style="swimlane;startSize=28;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1040" height="135" as="geometry" />
        </mxCell>
        <mxCell id="l1_react" value="ReAct 编排引擎&#xa;【新增外部服务 / 库内运行时】&#xa;Planning 规划 -&gt; Tool 调用 -&gt; Reflection 反思" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=10.5;" vertex="1" parent="layer1">
          <mxGeometry x="25" y="45" width="235" height="65" as="geometry" />
        </mxCell>
        <mxCell id="l1_nl2sql" value="Select AI (NL2SQL)&#xa;【管控面 Agent 模块】&#xa;绑定元数据字典与 LLM，转高精度 SQL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=10.5;" vertex="1" parent="layer1">
          <mxGeometry x="280" y="45" width="215" height="65" as="geometry" />
        </mxCell>
        <mxCell id="l1_tools" value="In-DB Tool &amp; MCP 适配器&#xa;【外部独立网关服务 / 容器化】&#xa;暴露标准 MCP 接口，调度 PL/SQL 与 REST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=10.5;" vertex="1" parent="layer1">
          <mxGeometry x="515" y="45" width="245" height="65" as="geometry" />
        </mxCell>
        <mxCell id="l1_mem" value="长短期记忆与审计视图&#xa;【数据库内核表 + 系统视图】&#xa;USER_CLOUD_AI_CONVERSATION 审计表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=10.5;" vertex="1" parent="layer1">
          <mxGeometry x="780" y="45" width="235" height="65" as="geometry" />
        </mxCell>

        <!-- Connector Banner 1 -> 2 -->
        <mxCell id="banner12" value="层间配合：库内函数调用 (DBMS_CLOUD_AI / In-DB UDF) ── 外部 Agent 下发执行计划 / 事务上下文传递 / 记忆读写" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0288d1;fontStyle=1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="100" y="185" width="940" height="34" as="geometry" />
        </mxCell>

        <!-- Middle Layer: Converged Engine -->
        <mxCell id="layer2" value="2. 统一多模 SQL 计算引擎层 (Oracle AI Database 26ai Converged Engine)  【落点：数据库内核 C++ 核心进程】" style="swimlane;startSize=28;fillColor=#ede7f6;strokeColor=#512da8;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="1040" height="155" as="geometry" />
        </mxCell>
        <mxCell id="l2_tp" value="OLTP 事务引擎&#xa;【数据库内核模块】&#xa;ACID 强一致 / 行存 / 锁管理 / 写 Redo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=10.5;" vertex="1" parent="layer2">
          <mxGeometry x="25" y="45" width="225" height="75" as="geometry" />
        </mxCell>
        <mxCell id="l2_ap" value="Database In-Memory (AP)&#xa;【数据库内核列存模块】&#xa;双格式内存列存 / SIMD 向量化加速&#xa;(写入行存 ── 内核Redo流 ──&gt; 列存免ETL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=10.5;" vertex="1" parent="layer2">
          <mxGeometry x="270" y="45" width="235" height="75" as="geometry" />
        </mxCell>
        <mxCell id="l2_vec" value="AI Vector Search &amp; ONNX&#xa;【数据库内核向量模块 + 同机Sidecar】&#xa;原生 VECTOR 类型 / HNSW 索引 / 库内推理&#xa;(写入自动触发向量化，保持事务原子性)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=10.5;" vertex="1" parent="layer2">
          <mxGeometry x="525" y="45" width="245" height="75" as="geometry" />
        </mxCell>
        <mxCell id="l2_multi" value="JSON Duality &amp; Graph&#xa;【数据库内核多模模块】&#xa;属性图分析 / 关系与文档双向透明映射" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=10.5;" vertex="1" parent="layer2">
          <mxGeometry x="790" y="45" width="225" height="75" as="geometry" />
        </mxCell>

        <!-- Connector Banner 2 -> 3 -->
        <mxCell id="banner23" value="层间配合：存储硬件算子下推 (Smart Scan: 向量距离计算/谓词过滤) ── 闪存缓存加速 &amp; 外部湖原位只读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;fontStyle=1;fontSize=11;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="100" y="415" width="940" height="34" as="geometry" />
        </mxCell>

        <!-- Bottom Layer: Storage & Lakehouse -->
        <mxCell id="layer3" value="3. 智能存储与开放湖仓加速层 (Exadata AI Storage &amp; Autonomous Lakehouse)  【落点：底层存储节点 + 湖仓连接器】" style="swimlane;startSize=28;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="1040" height="155" as="geometry" />
        </mxCell>
        <mxCell id="l3_smart" value="Exadata Smart Scan&#xa;【存储节点底层软件/FPGA下推】&#xa;向量距离计算与谓词在存储硬件并发下推&#xa;(仅返回 Top-K 结果，降低 90%+ 网络 IO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=10.5;" vertex="1" parent="layer3">
          <mxGeometry x="25" y="45" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l3_cache" value="True Cache &amp; Exascale 闪存&#xa;【分布式缓存集群 / 硬件加速】&#xa;事务一致性中层缓存 / 闪存高速加速&#xa;(为高并发分析提供极低延迟)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=10.5;" vertex="1" parent="layer3">
          <mxGeometry x="360" y="45" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l3_lake" value="Autonomous AI Catalog &amp; 外部湖互通&#xa;【外部湖仓连接插件 / 管控面 Catalog】&#xa;原位直读 Apache Iceberg / Delta Sharing&#xa;(库内核心交易数据与外部大数据原位关联 Join)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=10.5;" vertex="1" parent="layer3">
          <mxGeometry x="695" y="45" width="320" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
