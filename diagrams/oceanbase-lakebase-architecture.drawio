<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0"><diagram id="oceanbase-lakebase-architecture" name="OceanBase：数据库内多模/搜索 + External Catalog + 开放计算"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageWidth="1200" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="OceanBase SQL / 事务 / HTAP 内核&amp;#xa;关系、JSON、全文、向量与混合搜索&amp;#xa;语义索引自动把 VARCHAR 转向量并建索引&amp;#xa;[B1][B2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="45" width="300" height="100" as="geometry" /></mxCell><mxCell id="3" value="AI 函数服务（SQL 表达式）&amp;#xa;AI_SPLIT_DOCUMENT / AI_EMBED /&amp;#xa;AI_COMPLETE / AI_RERANK&amp;#xa;[B2]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="45" width="300" height="100" as="geometry" /></mxCell><mxCell id="4" value="第三方模型服务端点&amp;#xa;通过 DBMS_AI_SERVICE 注册模型和 endpoint&amp;#xa;需 API Key；具体模型服务在数据库外&amp;#xa;[B2][B3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="45" width="280" height="100" as="geometry" /></mxCell><mxCell id="5" value="External Catalog&amp;#xa;HMS / Iceberg REST / FILESYSTEM / ODPS&amp;#xa;读取表定义、snapshot、manifest&amp;#xa;[B4][B5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="300" height="100" as="geometry" /></mxCell><mxCell id="6" value="OceanBase 外部表/目录访问层&amp;#xa;解析 Parquet/ORC/CSV 与 Iceberg 元数据&amp;#xa;纳入 OceanBase SQL 查询&amp;#xa;[B4][B5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="245" width="300" height="100" as="geometry" /></mxCell><mxCell id="7" value="外部湖存储&amp;#xa;OSS / S3 / HDFS + Parquet/Iceberg&amp;#xa;当前文档：External Catalog 以只读为主&amp;#xa;[B4][B5]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="245" width="280" height="100" as="geometry" /></mxCell><mxCell id="8" value="开放计算引擎&amp;#xa;Spark / Ray（官方产品路线）&amp;#xa;通过开放格式/Catalog 或连接器协作&amp;#xa;[B1][B6]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="445" width="300" height="95" as="geometry" /></mxCell><mxCell id="9" value="Fork Database / Agent 沙箱&amp;#xa;官方方案页声明：克隆、隔离、Diff/回滚&amp;#xa;内部进程与实现细节未公开&amp;#xa;[B1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="445" width="300" height="95" as="geometry" /></mxCell><mxCell id="10" value="上下文/应用层&amp;#xa;PowerMem / DataPilot / Agent 应用&amp;#xa;属于产品与服务层，不等同数据库内核&amp;#xa;[B1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="445" width="280" height="95" as="geometry" /></mxCell><mxCell id="100" value="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="101" value="2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="102" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;fontSize=10;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="103" value="4" style="edgeStyle=orthogo