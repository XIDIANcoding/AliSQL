bd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="644" width="490" height="28" as="geometry" /></mxCell><mxCell id="111" value="3. 提供 schema/snapshot/manifest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="678" width="490" height="28" as="geometry" /></mxCell><mxCell id="112" value="4. 按元数据读取数据文件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="490" height="28" as="geometry" /></mxCell><mxCell id="113" value="5. 联邦/外部表查询" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="746" width="490" height="28" as="geometry" /></mxCell><mxCell id="114" value="6. 开放格式访问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="610" width="490" height="28" as="geometry" /></mxCell><mxCell id="115" value="7. 数据库克隆与隔离控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="644" width="490" height="28" as="geometry" /></mxCell><mxCell id="116" value="8. 结构化查询/混合检索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="678" width="490" height="28" as="geometry" /></mxCell><mxCell id="117" value="9. Embedding/生成/Rerank" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="590" y="712" width="490" height="28" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>