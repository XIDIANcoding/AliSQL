<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="snowflake-arch" name="Snowflake Cortex AI and Horizon Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Layer 1: Agent & Orchestration -->
        <mxCell id="l1" value="1. Cortex Agents 编排与双驱动工具层" style="swimlane;startSize=28;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1040" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l1_agent" value="Cortex Agent (智能路由)&#xa;Auto-Routing 意图分类 / 原生 MCP 端点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=11;fontStyle=1;" vertex="1" parent="l1">
          <mxGeometry x="25" y="45" width="235" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l1_analyst" value="工具 A: Cortex Analyst&#xa;结构化数据高精度 Text-to-SQL&#xa;绑定 Horizon 语义视图 (消除幻觉 SQL，准确率 &gt;90%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=11;" vertex="1" parent="l1">
          <mxGeometry x="280" y="45" width="345" height="80" as="geometry" />
        </mxCell>
        <mxCell id="l1_search" value="工具 B: Cortex Search &amp; Analytical Search&#xa;Layer 1: 自适应深度候选集剪枝召回&#xa;Layer 2: AI_FILTER / AI_EXTRACT / AI_AGG 库内算子分析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0288d1;fontSize=11;" vertex="1" parent="l1">
          <mxGeometry x="645" y="45" width="370" height="80" as="geometry" />
        </mxCell>

        <!-- Connector Banner 1 -> 2 -->
        <mxCell id="banner_sf_12" value="层间配合：语义驱动与政策校验 ── Cortex Analyst 读取语义模型生成 SQL，PDP 实时拦截越权与敏感数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=11;fontColor=#01579b;" vertex="1" parent="1">
          <mxGeometry x="120" y="195" width="900" height="34" as="geometry" />
        </mxCell>

        <!-- Layer 2: Horizon Catalog -->
        <mxCell id="l2" value="2. 统一治理控制面 (Snowflake Horizon Catalog / Apache Polaris)" style="swimlane;startSize=28;fillColor=#ede7f6;strokeColor=#512da8;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="245" width="1040" height="135" as="geometry" />
        </mxCell>
        <mxCell id="l2_sem" value="Semantic Views (语义即代码)&#xa;指标公式 / 维度关系 / 同义词声明&#xa;(统一业务口径，支撑 AI 精准理解)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=11;" vertex="1" parent="l2">
          <mxGeometry x="25" y="45" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="l2_sec" value="Policy Decision Point (PDP)&#xa;动态脱敏 / 行访问策略 (Row-Access)&#xa;(跨 SQL 与向量查询统一生效)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=11;" vertex="1" parent="l2">
          <mxGeometry x="360" y="45" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="l2_guard" value="Cortex AI Guardrails&#xa;PII 敏感数据拦截 / Agent 运行时审计&#xa;(保障生成内容符合安全合规标准)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#512da8;fontSize=11;" vertex="1" parent="l2">
          <mxGeometry x="695" y="45" width="320" height="65" as="geometry" />
        </mxCell>

        <!-- Connector Banner 2 -> 3 -->
        <mxCell id="banner_sf_23" value="层间配合：安全授权下发到无共享虚拟数仓 ── 双向读写内部表与 S3/Azure 开放 Iceberg 外部表 (物理零搬迁)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#512da8;fontStyle=1;fontSize=11;fontColor=#4a148c;" vertex="1" parent="1">
          <mxGeometry x="120" y="395" width="900" height="34" as="geometry" />
        </mxCell>

        <!-- Layer 3: Elastic Compute & Storage -->
        <mxCell id="l3" value="3. 弹性计算与统一存储层 (Snowflake Managed Tables &amp; Apache Iceberg)" style="swimlane;startSize=28;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;fontSize=13;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="445" width="1040" height="145" as="geometry" />
        </mxCell>
        <mxCell id="l3_wh" value="虚拟仓库 (Virtual Warehouses)&#xa;隔离的弹性计算资源 / 无锁多读多写&#xa;(支持分析与 AI 推理算力按需秒级伸缩)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="l3">
          <mxGeometry x="25" y="45" width="465" height="70" as="geometry" />
        </mxCell>
        <mxCell id="l3_ice" value="双向开放存储 (Open Iceberg REST Catalog)&#xa;内部微分区专有表 + S3/Azure 开放 Iceberg 外部表&#xa;(统一格式治理，消除数据孤岛)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=11;" vertex="1" parent="l3">
          <mxGeometry x="515" y="45" width="500" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
